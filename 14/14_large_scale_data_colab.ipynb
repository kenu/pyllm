  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### PySpark 기본 사용"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 샘플 데이터 생성\n",
    "data = [
",
    "    (1, \"Alice\", 25, \"Engineering\", 75000),
",
    "    (2, \"Bob\", 30, \"Marketing\", 65000),
",
    "    (3, \"Charlie\", 35, \"Engineering\", 80000),
",
    "    (4, \"Diana\", 28, \"Sales\", 55000),
",
    "    (5, \"Eve\", 32, \"Marketing\", 70000)
",
    "]
",
    "\n",
    "# 스키마 정의\n",
    "schema = [\"id\", \"name\", \"age\", \"department\", \"salary\"]\n",
    "\n",
    "# DataFrame 생성\n",
    "df = spark.createDataFrame(data, schema)\n",
    "\n",
    "# DataFrame 기본 정보\n",
    "print(\"DataFrame 스키마:\")\n",
    "df.printSchema()\n",
    "\n",
    "print(\"DataFrame 데이터:\")\n",
    "df.show()\n",
    "\n",
    "# 기본 통계\n",
    "print(\"기본 통계:\")\n",
    "df.describe().show()\n",
    "\n",
    "# 필터링\n",
    "print(\"Engineering 부서 직원:\")\n",
    "df.filter(col(\"department\") == \"Engineering\").show()\n",
    "\n",
    "# 그룹화\n",
    "print(\"부서별 통계:\")\n",
    "dept_stats = df.groupBy(\"department\").agg(
",
    "    count(\"*\").alias(\"employee_count\"),
",
    "    mean(\"age\").alias(\"avg_age\"),
",
    "    mean(\"salary\").alias(\"avg_salary\")
",
    ")\n",
    "dept_stats.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Spark SQL 및 고급 연산"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 임시 뷰 생성\n",
    "df.createOrReplaceTempView(\"employees\")\n",
    "\n",
    "# SQL 쿼리 실행\n",
    "print(\"SQL 쿼리 결과:\")\n",
    "result = spark.sql(\"""\n",
    "    SELECT 
",
    "        department,
",
    "        COUNT(*) as employee_count,
",
    "        AVG(age) as avg_age,
",
    "        AVG(salary) as avg_salary,
",
    "        MAX(salary) as max_salary
",
    "    FROM employees
",
    "    GROUP BY department
",
    "    ORDER BY avg_salary DESC
",
    """")\n",
    "result.show()\n",
    "\n",
    "# 창 함수 사용\n",
    "from pyspark.sql.window import Window\n",
    "from pyspark.sql.functions import row_number, desc\n",
    "\n",
    "# 부서 내 급여 순위\n",
    "window_spec = Window.partitionBy(\"department\").orderBy(desc(\"salary\"))\n",
    "\n",
    "ranked_df = df.withColumn(
",
    "    \"salary_rank\",\n",
    "    row_number().over(window_spec)
",
    ")\n",
    "\n",
    "print(\"부서별 급여 순위:\")\n",
    "ranked_df.show()\n",
    "\n",
    "# 조인 연산\n",
    "departments_data = [
",
    "    (\"Engineering\", \"Tech\"),
",
    "    (\"Marketing\", \"Business\"),
",
    "    (\"Sales\", \"Business\")
",
    "]
",
    "\n",
    "dept_df = spark.createDataFrame(departments_data, [\"dept_name\", \"category\"])\n",
    "\n",
    "# 조인\n",
    "joined_df = df.join(
",
    "    dept_df,\n",
    "    df.department == dept_df.dept_name,\n",
    "    \"left\"
",
    ")\n",
    "\n",
    "print(\"조인 결과:\")\n",
    "joined_df.show()"
   ]
  },
