    "## 6. 실전 프로젝트: 대규모 로그 분석"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "print(\"\n=== 실전 프로젝트: 대규모 로그 분석 ===\")\n",
    "\n",
    "from datetime import datetime, timedelta\n",
    "import random\n",
    "\n",
    "def generate_log_data(num_logs=50000):\n",
    "    \"\"\"로그 데이터 생성\"\"\"\n",
    "    log_levels = ['INFO', 'WARNING', 'ERROR', 'DEBUG']\n",
    "    services = ['web', 'database', 'cache', 'queue']\n",
    "    logs = []\n",
    "    base_time = datetime.now()\n",
    "    \n",
    "    for i in range(num_logs):\n",
    "        log_entry = {\n",
    "            'timestamp': base_time - timedelta(seconds=i*5),\n",
    "            'level': random.choice(log_levels),\n",
    "            'service': random.choice(services),\n",
    "            'message': f'Log message {i}',\n",
    "            'response_time': random.uniform(0.1, 5.0),\n",
    "            'status_code': random.choice([200, 201, 400, 404, 500])\n",
    "        }\n",
    "        logs.append(log_entry)\n",
    "    return pd.DataFrame(logs)\n",
    "\n",
    "# 데이터 생성\n",
    "print(\"로그 데이터 생성...\")\n",
    "df_logs = generate_log_data()\n",
    "print(f\"생성된 로그 수: {len(df_logs)}\")\n",
    "\n",
    "# Dask DataFrame으로 변환\n",
    "ddf_logs = dd.from_pandas(df_logs, npartitions=4)\n",
    "\n",
    "# 분산 분석\n",
    "print(\"\n분산 로그 분석 실행...\")\n",
    "level_counts = ddf_logs['level'].value_counts().compute()\n",
    "service_stats = ddf_logs.groupby('service')['response_time'].agg(['mean', 'max']).compute()\n",
    "error_rate = (ddf_logs['level'] == 'ERROR').sum().compute() / len(ddf_logs) * 100\n",
    "\n",
    "print(\"\n=== 분석 결과 ===\")\n",
    "print(f\"전체 로그 수: {len(ddf_logs)}\")\n",
    "print(f\"에러율: {error_rate:.2f}%\n\")\n",
    "\n",
    "print(\"로그 레벨 분포:\")\n",
    "print(level_counts)\n",
    "\n",
    "print(\"\n서비스별 성능:\")\n",
    "print(service_stats)\n",
    "\n",
    "# 로그 파일을 CSV로 저장하여 분산 처리 시뮬레이션\n",
    "log_files = 'logs_*.csv'\n",
    "ddf_logs.to_csv(log_files, index=False)\n",
    "print(f\"\n로그 데이터를 '{log_files}' 패턴으로 저장했습니다.\")\n",
    "\n",
    "# 저장된 CSV 파일들로부터 Dask DataFrame 다시 로드\n",
    "ddf_from_files = dd.read_csv(log_files, parse_dates=['timestamp'])\n",
    "print(\"\n파일에서 Dask DataFrame 로드 완료.\")\n",
    "\n",
    "# 파일로부터 로드한 데이터로 분석 재수행\n",
    "hourly_stats = ddf_from_files.groupby(ddf_from_files['timestamp'].dt.hour).size().compute()\n",
    "print(\"\n시간대별 로그 발생 건수:\")\n",
    "print(hourly_stats.sort_index())"
   ]
