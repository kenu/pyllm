  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Parquet 및 ORC 포맷\n",
    "효율적인 데이터 저장을 위해 Parquet 포맷을 사용합니다."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "print(\"\n=== Parquet 포맷 처리 ===\")\n",
    "\n",
    "# Pandas DataFrame 생성\n",
    "data_parquet = pd.DataFrame({\n",
    "    'id': range(100000),\n",
    "    'value': np.random.randn(100000),\n",
    "    'category': np.random.choice(['A', 'B', 'C'], 100000)
",
    "})\n",
    "\n",
    "# Parquet 파일로 저장\n",
    "parquet_file = 'large_data.parquet'\n",
    "data_parquet.to_parquet(parquet_file)\n",
    "print(f\"'{parquet_file}' 파일로 저장 완료\")\n",
    "\n",
    "# Parquet 파일 읽기\n",
    "df_parquet = pd.read_parquet(parquet_file)\n",
    "print(f\"'{parquet_file}' 파일 읽기 완료. 크기: {df_parquet.shape}\")\n",
    "\n",
    "# Dask로 Parquet 처리\n",
    "ddf_parquet = dd.read_parquet(parquet_file)\n",
    "result = ddf_parquet.groupby('category')['value'].mean().compute()\n",
